#version 450

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout (set = 0, binding = 0, rgba8) uniform image2D u_Image;

layout (push_constant) uniform PushConstant {
    vec2 resolution;
} pc;

void main() {
    vec2 uv = ivec2(gl_GlobalInvocationID.xy) / pc.resolution;
    imageStore(u_Image, ivec2(gl_GlobalInvocationID.xy), vec4(uv, 0.0, 1.0));
}